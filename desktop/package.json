{
  "name": "silent-p-pwsa-desktop",
  "productName": "FYPM Browser",
  "desktopName": "fypm-browser.desktop",
  "version": "0.4.0-alpha.1",
  "description": "FYPM Browser desktop test build with persistent isolated containers",
  "main": "bootstrap.js",
  "author": {
    "name": "Silent P.",
    "email": "252804653+fkdyall@users.noreply.github.com"
  },
  "homepage": "https://github.com/fkdyall/silentp.webspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/fkdyall/silentp.webspace.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:clipboard": "node test-clipboard-permissions.js",
    "check": "node test-profile-model.js && node test-privacy-policy.js && node test-browser-ui.js && node test-container-model.js && node test-state-store.js && node test-context-menu.js && node test-clipboard-permissions.js && node --check bootstrap.js && node --check clipboard-permissions.js && node --check profile-model.js && node --check privacy-policy.js && node --check container-model.js && node --check state-store.js && node --check context-menu.js && node --check main.js && node --check preload.js && node --check security.js && node --check ../web/ui-model.js && node --check ../web/app.js && node check-architecture.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:linux:all": "electron-builder --linux AppImage deb --publish never",
    "dist:win:all": "electron-builder --win nsis portable --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fypm.silentpwebspace",
    "productName": "FYPM Browser",
    "executableName": "fypm-browser",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "bootstrap.js",
      "clipboard-permissions.js",
      "profile-model.js",
      "privacy-policy.js",
      "container-model.js",
      "context-menu.js",
      "main.js",
      "preload.js",
      "security.js",
      "state-store.js",
      "check-architecture.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser;",
      "maintainer": "FYPM Browser <252804653+fkdyall@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "appImage": {
      "artifactName": "FYPM-Browser-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "FYPM-Browser-${version}-linux-${arch}.${ext}",
      "maintainer": "FYPM Browser <252804653+fkdyall@users.noreply.github.com>"
    },
    "portable": {
      "artifactName": "Silent-P-PWSA-${version}-windows-portable-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Silent-P-PWSA-${version}-windows-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
